{
  "manifest_version": 3,
  "name": "doA2Ai",
  "short_name": "doA2Ai",
  "description": "Connects an external agent to bounded current-page WebMCP tools with exception-only human authority.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "149",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "doA2Ai",
    "default_popup": "popup.html"
  },
  "options_page": "setup.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}

{
  "manifest_version": 3,
  "name": "WebMCP Current Page",
  "short_name": "Current Page",
  "description": "Shows the WebMCP capabilities exposed by the current page.",
  "version": "0.1.0",
  "minimum_chrome_version": "149",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Current page",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
